# Chronicle Docker deployment settings.
# Copy this file to .env.chronicle and replace the password before deployment.

CHRONICLE_POSTGRES_USER=chronicle
CHRONICLE_POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
CHRONICLE_POSTGRES_DB=chronicle

# Persistent PostgreSQL files live under this host directory.
CHRONICLE_DATA_DIR=/srv/loom-data/chronicle

# Default is loopback for use behind Nginx/Caddy/Tailscale.
# Set to 0.0.0.0 only when you intentionally want direct public access.
CHRONICLE_BIND_IP=127.0.0.1
CHRONICLE_PORT=8080

# Local image tag built by Docker Compose.
CHRONICLE_IMAGE_TAG=local

# Single Studio administrator (C1-T2). The Rust chronicle-web fronts the
# deployment; every /api/v1/studio/* route requires these credentials via
# HTTP Basic. Leave both empty to keep Studio disabled (fail-closed 503):
# public reads and the web front keep working.
# Generate with: openssl rand -hex 24
# CHRONICLE_ADMIN_USER=admin
# CHRONICLE_ADMIN_PASSWORD=replace-with-a-long-random-hex-password

# Chronicle-owned source data directory (C1-T3). Uploaded .txt/.md revision
# files persist here under relative storage keys, on the same supported
# data volume as PostgreSQL so content survives restart/redeploy.
# Compose mounts ${CHRONICLE_DATA_DIR}/sources at this path in the
# sidecar; local development defaults to ./chronicle-sources.
# CHRONICLE_SOURCE_DIR=/var/lib/chronicle/sources

# Per-file upload ceiling in bytes (C1-T3). Defaults to 10485760 (10 MiB).
# CHRONICLE_MAX_UPLOAD_BYTES=10485760
