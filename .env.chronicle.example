# Chronicle Docker deployment settings.
# Copy this file to .env.chronicle and replace the password before deployment.

CHRONICLE_POSTGRES_USER=chronicle
CHRONICLE_POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
CHRONICLE_POSTGRES_DB=chronicle

# Persistent PostgreSQL files live under this host directory.
CHRONICLE_DATA_DIR=/srv/loom-data/chronicle

# Default is loopback for use behind Nginx/Caddy/Tailscale.
# Set to 0.0.0.0 only when you intentionally want direct public access.
CHRONICLE_BIND_IP=127.0.0.1
CHRONICLE_PORT=8080

# Local image tag built by Docker Compose.
CHRONICLE_IMAGE_TAG=local

# Single Studio administrator (C1-T2). The Rust chronicle-web fronts the
# deployment; every /api/v1/studio/* route requires these credentials via
# HTTP Basic. Leave both empty to keep Studio disabled (fail-closed 503):
# public reads and the web front keep working.
# Generate with: openssl rand -hex 24
# CHRONICLE_ADMIN_USER=admin
# CHRONICLE_ADMIN_PASSWORD=replace-with-a-long-random-hex-password

# Chronicle-owned source data directory (C1-T3). Uploaded .txt/.md revision
# files persist here under relative storage keys, on the same supported
# data volume as PostgreSQL so content survives restart/redeploy.
# Compose mounts ${CHRONICLE_DATA_DIR}/sources at this path in the
# sidecar; local development defaults to ./chronicle-sources.
# CHRONICLE_SOURCE_DIR=/var/lib/chronicle/sources

# Per-file upload ceiling in bytes (C1-T3). Defaults to 10485760 (10 MiB).
# CHRONICLE_MAX_UPLOAD_BYTES=10485760


# Production model transport. Configure a staged chapter model or pipeline
# profile before starting the worker; missing configuration fails startup.
# The endpoint must support Responses or Chat Completions as selected by the
# chapter pipeline profile.
# OpenAI example: https://api.openai.com/v1/responses
# A Luna/local gateway may be used through the same compatible contract.
# Never put credentials in CHRONICLE_MODEL_ENDPOINT.
# CHRONICLE_MODEL_ENDPOINT=https://api.openai.com/v1/responses
# CHRONICLE_MODEL_API_KEY=replace-with-provider-api-key
# Global per-attempt timeout for every production model and chapter step.
# Per-model/per-step timeout overrides are not supported.
# CHRONICLE_MODEL_TIMEOUT_SECONDS=600
#
# Staged natural-chapter pipeline entry (chapter_stage.chapter_model_from_env).
# Compose passes the selected model/profile into chronicle-worker.
# Production requires a staged 0.4 provider before it claims source jobs.
# CHRONICLE_CHAPTER_MODEL=replace-with-primary-model
# Optional comma-separated review/comparison model names; default is primary.
# CHRONICLE_CHAPTER_REVIEW_MODELS=replace-with-review-model
# Optional per-step profiles. Copy/edit worker/config/chapter-pipeline.example.json
# in a private config directory, then set both the host directory and container path.
# CHRONICLE_CHAPTER_CONFIG_DIR=/srv/loom-data/chronicle/config
# CHRONICLE_CHAPTER_PIPELINE_CONFIG=/etc/chronicle/chapter/chapter-pipeline.json
# Optional reviewed multi-source history, using the same endpoint/API key.
# Explicitly select published full chapters in Studio to queue a history job.
# Ordinary chapter imports do not regenerate the public historical narrative.
# Pauses present twice: corroboration review, then continuous-prose review.
# CHRONICLE_NARRATIVE_MODEL=replace-with-history-narrative-model

# C2-R1-T16 chapter-production §3 engineering envelope (Unicode chars,
# bytes, and output tokens). These bounds enter the chapter request
# fingerprint via ChapterLimits.from_env; an empty value keeps the
# contract default shown below. They are resource-protection limits, not
# a claim that the configured provider supports the full 64k output
# scale — the provider must actually support the configured
# context/output scale or chapter generation fails closed.
# CHRONICLE_CHAPTER_MAX_SOURCE_CHARS=32768
# CHRONICLE_CHAPTER_MAX_PROMPT_CHARS=262144
# CHRONICLE_CHAPTER_MAX_RESPONSE_CHARS=524288
# CHRONICLE_CHAPTER_MAX_RESPONSE_BYTES=4194304
# CHRONICLE_CHAPTER_MAX_OUTPUT_TOKENS=65536
