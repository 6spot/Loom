# Local PostgreSQL 18 + pgvector test service.
# Copy to .env.test.local and replace the password before starting the service.
POSTGRES_USER=loom
POSTGRES_PASSWORD=replace-with-a-local-test-password
POSTGRES_DB=loom_control
POSTGRES_PORT=15432

# Loom integration tests treat this as a control database. The role must be
# allowed to CREATE/DROP DATABASE because each test provisions an isolated DB.
LOOM_TEST_POSTGRES_URL=postgresql://loom:replace-with-a-local-test-password@127.0.0.1:15432/loom_control
LOOM_REQUIRE_POSTGRES_TESTS=1
