# Non-secret local deployment defaults. Copy to .env before `docker compose up`.
# Replace POSTGRES_PASSWORD outside development; do not commit the replacement.
POSTGRES_USER=loom
POSTGRES_PASSWORD=loom
POSTGRES_DB=loom_control

# Native startup uses this URL directly. Compose overrides the host to `postgres`.
LOOM_DATABASE_URL=postgresql://loom:loom@localhost:5432/loom_control
LOOM_DATA_DIR=./loom
LOOM_BIND_ADDR=0.0.0.0:8080

# Stable non-secret Runtime publication metadata.
LOOM_RUNTIME_REVISION_ID=loom-server
LOOM_CORE_BUILD_REF=loom-server-0.1.0

# Bounded worker operational settings (milliseconds/items).
LOOM_WORKER_LEASE_MS=30000
LOOM_WORKER_RETRY_BACKOFF_MS=1000
LOOM_WORKER_SCHEDULER_POLL_LIMIT=1
LOOM_WORKER_RECOVERY_BATCH_SIZE=256
LOOM_WORKER_POLL_MS=100
LOOM_INGRESS_QUEUE_CAPACITY=256
LOOM_INGRESS_MAX_PAYLOAD_BYTES=524288
LOOM_INGRESS_MAX_RETRY_ATTEMPTS=3

# Runtime semantic/resource bounds. Runtime applies these independently of
# HTTP transport limits, including for in-process callers.
LOOM_RUNTIME_MAX_ACTION_PAYLOAD_BYTES=262144
LOOM_RUNTIME_MAX_EVENT_PAYLOAD_BYTES=262144
LOOM_RUNTIME_MAX_WORK_PAYLOAD_BYTES=262144
LOOM_RUNTIME_MAX_SESSION_PROVENANCE_BYTES=4194304
LOOM_RUNTIME_MAX_SESSION_PROVENANCE_ENTRIES=4096
LOOM_RUNTIME_MAX_EVENTS=256
LOOM_RUNTIME_MAX_EFFECTS=1024
LOOM_RUNTIME_MAX_WORK_MUTATIONS=256
LOOM_RUNTIME_MAX_REACTION_SCHEDULES=256
LOOM_RUNTIME_MAX_SUBRESOLUTION_DEPTH=8
LOOM_RUNTIME_MAX_SUBRESOLUTION_COUNT=64
LOOM_RUNTIME_MAX_SEMANTIC_QUERIES=64
LOOM_RUNTIME_MAX_SEMANTIC_RESULTS=1024
LOOM_RUNTIME_MAX_SEMANTIC_RESULT_BYTES=1048576
LOOM_RUNTIME_MAX_SEMANTIC_DEPTH=32
LOOM_RUNTIME_MAX_SEMANTIC_FILTERS=1
LOOM_RUNTIME_MAX_HISTORY_PAGE_SIZE=1024
LOOM_RUNTIME_MAX_CAUSAL_DEPTH=64
LOOM_RUNTIME_MAX_CAUSAL_RESULTS=1024
LOOM_RUNTIME_MAX_CHANGE_FEED_PAGE_SIZE=256
LOOM_RUNTIME_MAX_CHRONOLOGY_COMPLETIONS=1024

# HTTP transport bounds.
LOOM_HTTP_MAX_BODY_BYTES=1048576
LOOM_HTTP_MAX_HEADER_BYTES=16384
LOOM_HTTP_MAX_RESPONSE_BYTES=8388608
LOOM_HTTP_MAX_SSE_BUFFER_BYTES=4194304
LOOM_HTTP_MAX_SSE_EVENTS=1000
LOOM_HTTP_MAX_CONCURRENT_REQUESTS=128

# Optional scheduler target. Set both values to enable one bounded worker for
# an existing Timeline; leave both empty when the database has no World yet.
# LOOM_SCHEDULER_WORLD_ID=
# LOOM_SCHEDULER_TIMELINE_ID=
