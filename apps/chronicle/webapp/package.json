{
  "name": "chronicle-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "Chronicle C1-T9 web foundation: one React/TypeScript/Vite build for public Chronicle pages and the shadcn-based Studio shell (application-owned, HTTP-API only, no DB access).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "smoke:dist": "node ./scripts/check-dist.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "~5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
