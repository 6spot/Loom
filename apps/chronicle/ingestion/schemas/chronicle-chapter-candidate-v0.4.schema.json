{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.local/chronicle/schemas/chronicle-chapter-candidate-v0.4.schema.json",
  "title": "Chronicle staged chapter candidate v0.4",
  "description": "Current 0.4 chapter candidate. All reusable chapter definitions come from the current shared definition bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "chapter_id",
    "bundle",
    "translation",
    "mentions",
    "record_sources",
    "reading",
    "person_states",
    "warnings",
    "source_scope"
  ],
  "properties": {
    "schema": {
      "const": "chronicle.chapter-candidate"
    },
    "version": {
      "const": "0.4"
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^ch_[0-9a-f]{24}$"
    },
    "bundle": {
      "$ref": "https://loom.local/chronicle/schemas/chronicle-chapter-shared-v0.4.schema.json#/$defs/staged_bundle"
    },
    "translation": {
      "$ref": "https://loom.local/chronicle/schemas/chronicle-chapter-shared-v0.4.schema.json#/$defs/translation"
    },
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "https://loom.local/chronicle/schemas/chronicle-chapter-shared-v0.4.schema.json#/$defs/mention"
      }
    },
    "record_sources": {
      "type": "array",
      "items": {
        "$ref": "https://loom.local/chronicle/schemas/chronicle-chapter-shared-v0.4.schema.json#/$defs/record_source"
      }
    },
    "reading": {
      "$ref": "https://loom.local/chronicle/schemas/chronicle-chapter-shared-v0.4.schema.json#/$defs/reading"
    },
    "person_states": {
      "$ref": "https://loom.local/chronicle/schemas/chronicle-chapter-shared-v0.4.schema.json#/$defs/person_states"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "https://loom.local/chronicle/schemas/chronicle-chapter-shared-v0.4.schema.json#/$defs/warning"
      }
    },
    "source_scope": {
      "$ref": "https://loom.local/chronicle/schemas/chronicle-chapter-shared-v0.4.schema.json#/$defs/source_scope"
    }
  }
}
