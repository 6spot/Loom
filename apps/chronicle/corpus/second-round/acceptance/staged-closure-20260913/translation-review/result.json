    "findings": [
      {
        "id": "f_001",
        "paragraph_id": "p_006",
        "kind": "mistranslation",
        "source_ids": [
          "b_009"
        ],
        "reason": "“为贼所破”的受事者是先主，译文却说成“高唐被贼军攻破”，改变了受败主体。",
        "replacement": "不久，大将军何进派都尉毌丘毅前往丹杨募兵，先主和他一同前往，在下邳遇到贼军，奋力作战立了战功，被任命为下密县丞。不久又弃官而去。后来任高唐县尉，升任县令。先主被贼军击败后，前往投奔中郎将公孙瓒。公孙瓒上表任命他为别部司马，让他和青州刺史田楷一起抵御冀州牧袁绍。先主多次立下战功，代理平原县令，后来又兼任平原国相。"
      },
      {
        "id": "f_002",
        "paragraph_id": "p_019",
        "kind": "mistranslation",
        "source_ids": [
          "b_015"
        ],
        "reason": "“辞受帝衣带中密诏”表示董承声称奉有衣带密诏，译文直接写成确定接受密诏，且“辞受”本身未被正确译解，未保留该说法的归属。",
        "replacement": "先主还没有出发时，献帝的舅父、车骑将军董承声称奉有献帝藏在衣带中的密诏，要诛杀曹操。先主还没有出兵。当时曹操从容地对先主说：“如今天下的英雄，只有使君和我曹操两个人。本初那一类人，不值得计算在内。”先主正在吃饭，听到这话，手中的匙和筷子都掉了下来。"
      },
      {
        "id": "f_003",
        "paragraph_id": "p_020",
        "kind": "mistranslation",
        "source_ids": [
          "b_015"
        ],
        "reason": "“会见使”中的“见使”是被派遣、受命出行，不是“有使者到来”。",
        "replacement": "先主于是和董承、长水校尉种辑、将军吴子兰、王子服等人共同谋划诛杀曹操。恰逢先主受命出行，事情尚未发动。后来谋划败露，董承等人都被处死。"
      },
      {
        "id": "f_004",
        "paragraph_id": "p_021",
        "kind": "mistranslation",
        "source_ids": [
          "b_017"
        ],
        "reason": "“灵等还”承接此前受先主督率出行的朱灵、路招等人，译文误作种辑等人返回。",
        "replacement": "先主占据下邳。朱灵、路招等人返回后，先主便杀了徐州刺史车胄，留下关羽守下邳，自己回到小沛。东海人昌霸反叛，许多郡县背叛曹操而归附先主，部众有数万人。先主派孙乾和袁绍联络结盟。曹操派刘岱、王忠进攻先主，但没有取胜。"
      },
      {
        "id": "f_005",
        "paragraph_id": "p_023",
        "kind": "mistranslation",
        "source_ids": [
          "b_019"
        ],
        "reason": "“袁谭，先主故茂才也”是说袁谭从前由先主举为茂才；译文遗漏先主为举主，并无据补充二人“有旧交”。",
        "replacement": "先主逃往青州。青州刺史袁谭过去曾由先主举为茂才，便率领步兵、骑兵迎接先主。先主跟随袁谭到了平原，袁谭派快马向袁绍报告。袁绍派将领在沿途迎接，自己离开邺城二百里，和先主相见。"
      },
      {
        "id": "f_006",
        "paragraph_id": "p_026",
        "kind": "mistranslation",
        "source_ids": [
          "b_021"
        ],
        "reason": "“自南击先主”是曹操击破袁绍后向南进攻先主，译文“从南面进攻”改变了行军方向关系。",
        "replacement": "曹操打败袁绍后，便向南进攻先主。先主派麋竺、孙乾和刘表联络，刘表亲自到郊外迎接他，以接待上宾的礼节对待他，又增给他兵力，让他驻扎在新野。荆州豪杰归附先主的越来越多，刘表怀疑他的心意，暗中防备他。"
      },
      {
        "id": "f_007",
        "paragraph_id": "p_029",
        "kind": "mistranslation",
        "source_ids": [
          "b_023"
        ],
        "reason": "“至宛乃闻之”是曹操到达宛城时先主才获知消息，译文误成先主到了宛城才听说。",
        "replacement": "先主驻扎在樊城，不知道曹操突然到来，直到曹操到达宛城时才听说，于是率领部众离开。经过襄阳时，诸葛亮劝先主进攻刘琮，说这样就可以取得荆州。先主说：“我不忍心这样做。”"
      },
      {
        "id": "f_008",
        "paragraph_id": "p_036",
        "kind": "mistranslation",
        "source_ids": [
          "b_027"
        ],
        "reason": "“雷绪率部曲数万口”是雷绪所率部曲有数万人，译文拆成“部曲”和“数万部众”两组人员。",
        "replacement": "先主上表推荐刘琦为荆州刺史，又向南征讨荆州南部四郡。武陵太守金旋、长沙太守韩玄、桂阳太守赵范、零陵太守刘度都投降了。庐江人雷绪率领数万名部曲前来叩头归附。"
      },
      {
        "id": "f_009",
        "paragraph_id": "p_044",
        "kind": "mistranslation",
        "source_ids": [
          "b_033"
        ],
        "reason": "原文是张松让法正禀告先主，而谋臣庞统也进言；译文说成张松又让庞统进言，无据改变了庞统进说的发起者。",
        "replacement": "先主留下诸葛亮、关羽等人据守荆州，率领数万步兵进入益州。到达涪县后，刘璋亲自出城迎接，两人相见十分欢洽。张松让法正向先主说明，谋臣庞统也进言，说可以趁会面之机袭击刘璋。先主说：“这是大事，不能仓促行事。”"
      },
      {
        "id": "f_010",
        "paragraph_id": "p_051",
        "kind": "mistranslation",
        "source_ids": [
          "b_035"
        ],
        "reason": "此处“关中”指关内、关城之中，并非作为地域名称的关中；译文造成明确地理误解。",
        "replacement": "先主径直进入关内，扣留诸将和士卒的妻子儿女，率军和黄忠、卓膺等人一同前进，到达涪县，占据了城池。刘璋派刘璝、冷苞、张任、邓贤等人在涪县抵御先主，都被击败，只得退守绵竹。刘璋又派李严统领绵竹各军，李严率领部众投降先主。"
      },
      {
        "id": "f_011",
        "paragraph_id": "p_055",
        "kind": "mistranslation",
        "source_ids": [
          "b_037"
        ],
        "reason": "“刘巴者宿昔之所忌恨也”是刘巴过去为先主所忌恨；译文反说刘巴厌恶、怨恨先主，颠倒主客体。",
        "replacement": "董和、黄权、李严等人本来都是刘璋任用的，吴壹、费观等又是刘璋的姻亲，彭羕曾经被刘璋排斥，刘巴则是先主过去一直忌恨的人，但先主都把他们安排在重要职位上，让他们充分发挥才能。有志向的人无不争相努力。"
      },
      {
        "id": "f_012",
        "paragraph_id": "p_058",
        "kind": "mistranslation",
        "source_ids": [
          "b_039"
        ],
        "reason": "瓦口战败后“收兵还南郑”的是张郃等曹军，译文沿用先主一方为主语，误成先主或张飞收兵返回南郑。",
        "replacement": "先主派黄权率兵迎接张鲁，但张鲁已经投降曹操。曹操派夏侯渊、张郃驻守汉中，多次侵犯巴地边界。先主命令张飞进军宕渠，在瓦口和张郃等人交战，击败张郃等人；张郃等收拢残兵返回南郑。先主也回到成都。"
      },
      {
        "id": "f_013",
        "paragraph_id": "p_061",
        "kind": "addition",
        "source_ids": [
          "b_043"
        ],
        "reason": "“亡者日多”指逃亡者日益增多，译文无据增加“死亡的人”。",
        "replacement": "曹操从长安调集军队南下征讨。先主远远地判断说：“曹操即使来了，也无能为力，我一定能够拥有汉川。”曹操到达后，先主收拢部队，据险防守，始终不和他交战。曹操围攻数月不能攻破，军中逃亡的人一天比一天多。到了夏天，曹操果然率军撤回，先主于是占有汉中。随后派刘封、孟达、李平等人进攻上庸的申耽。"
      },
      {
        "id": "f_014",
        "paragraph_id": "p_065",
        "kind": "mistranslation",
        "source_ids": [
          "b_047"
        ],
        "reason": "“欲盗神器”的承接主语仍是奏表所指控的曹操，译文改成泛指“有人”，削弱并改变了指控对象。",
        "replacement": "我们恭敬地想到，陛下天生具有圣明的德性，统治万邦，却遭逢厄运和不幸的艰难。董卓首先制造祸乱，倾覆京城；曹操又借此造成灾祸，窃取并控制朝廷权柄。他毒杀皇后和太子，残害天下，摧残百姓，长期使陛下蒙受流亡和忧患，幽闭在偏僻空虚的城邑之中。人神都失去了主宰，王命被阻断，皇权被蒙蔽，曹操企图盗取帝位。"
      },
      {
        "id": "f_015",
        "paragraph_id": "p_068",
        "kind": "mistranslation",
        "source_ids": [
          "b_047"
        ],
        "reason": "“臣等以备肺腑枝叶，宗子籓翰”是群臣认为刘备属于皇室至亲枝叶、宗室屏藩，不是群臣自称为刘备的近亲。",
        "replacement": "汉朝兴起之初，分割疆土，尊封刘氏宗室子弟，因此最终挫败了诸吕之乱，奠定了汉太宗的基业。我们认为刘备是皇室的至亲枝叶、宗室的屏藩，心中存念国家，想的是平息祸乱。"
      },
      {
        "id": "f_016",
        "paragraph_id": "p_074",
        "kind": "mistranslation",
        "source_ids": [
          "b_053"
        ],
        "reason": "“反侧”在此指反复不安、怀有异志的人或动乱局势，是臣所忧虑的对象，不是臣本人“辗转反侧”。",
        "replacement": "臣凭着平庸的才能，承受上将军的职任，统率三军，在外奉行诏命，却不能扫除贼寇、安定匡正王室，长久使陛下的圣教衰微。天下之内，局势仍然闭塞不安，臣只忧虑人心反复不安，痛苦得如同患了严重的头痛。"
      },
      {
        "id": "f_017",
        "paragraph_id": "p_085",
        "kind": "addition",
        "source_ids": [
          "b_059"
        ],
        "reason": "原文只有“臣父群”，可知父亲名群，但没有提供刘姓；译文补作“刘群”无正文依据。",
        "replacement": "臣的父亲生前曾说，西南方多次出现黄色云气，高达数丈，直立不散，已经持续了很多年；又时时有祥瑞的云彩和风，从璇玑星所在方向降下，与这些云气相应，这就是奇异的祥瑞。"
      },
      {
        "id": "f_018",
        "paragraph_id": "p_093",
        "kind": "mistranslation",
        "source_ids": [
          "b_063"
        ],
        "reason": "本篇劝进文中的“二祖”指汉高祖和汉光武帝，与后文“以纂二祖”相应，不是周文王、周武王。",
        "replacement": "过去周朝有乌鸦和鱼的祥瑞，人们都说这是美好的征兆。汉高祖、汉光武帝两位先祖承受天命时，《河图》《洛书》也都先行记载，作为应验的征兆。如今上天已经降下祥瑞，群儒英俊纷纷拿出《河图》《洛书》以及孔子的谶书、记载，所有征验都已经完备。"
      },
      {
        "id": "f_019",
        "paragraph_id": "p_106",
        "kind": "mistranslation",
        "source_ids": [
          "b_073"
        ],
        "reason": "“收兵还巫”承接上一段驻南山追击的吴将李异、刘阿等，收兵返回巫县的是吴军，不是已经退至鱼复、白帝一带的先主。",
        "replacement": "秋八月，吴军收兵返回巫县。司徒许靖去世。冬十月，先主下诏命令丞相诸葛亮在成都修建南郊、北郊祭坛。孙权听说先主驻扎白帝，非常害怕，派使者请求讲和。先主答应了，派太中大夫宗瑋回报孙权。"
      }
    ]
  },
