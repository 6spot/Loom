      "phase_id": "p_xun",
      "segments": [
        {
          "conclusion_ids": [
            "added_xun_office"
          ],
          "event_id": "01a09988-8a05-7433-adba-5bfba9368d71",
          "event_relation": "current",
          "event_text": null,
          "text": "周循获任骑都尉，颇有周瑜的风范。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-7d7b-b494-7994fe35b6c0",
          "importance": "primary"
        }
      ],
      "id": "para_xun_death",
      "phase_id": "p_xun_death",
      "segments": [
        {
          "conclusion_ids": [
            "added_xun_death"
          ],
          "event_id": null,
          "event_relation": null,
          "event_text": null,
          "text": "周循早逝。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-7e20-b640-068fd30eb1f8",
          "importance": "primary"
        },
