      "id": "para_redcliff",
      "phase_id": "p_redcliff",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_019",
            "added_huanggai_allegiance"
          ],
          "event_id": "01a09988-8a05-70b2-8d48-68154f401aba",
          "event_relation": "current",
          "event_text": "赤壁",
          "text": "孙权于是派周瑜、程普等与刘备合力迎战曹操，在赤壁相遇。曹军已有疾病，初战失利后退驻江北，周瑜等在南岸。黄盖认为敌众我寡、难以持久，见曹军船舰首尾相接，便建议火攻。他备下装有柴草、浇过油脂的战船，覆帷幕、建旗号，先致书曹操诈降，又把轻便小船系在大船后。曹军以为黄盖来降，黄盖纵火，烈风将火势带到岸上营寨，烟焰冲天，曹军人马烧死、溺死者甚多，遂败退。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-7b86-b16d-9f6904ea6a0d",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-72ec-833a-7907184f9945",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a05-7dbd-86e9-d6f30006ec38",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7255-980c-bba704a589b6",
          "importance": "other"
        }
      ],
      "id": "para_retreat",
      "phase_id": "p_retreat",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_020",
            "added_caoren_allegiance",
            "added_jiangling_before"
          ],
          "event_id": "01a09988-8a05-7251-8d1f-0376547e08fb",
          "event_relation": "current",
          "event_text": null,
          "text": "曹军败退后退保南郡，刘备与周瑜等继续追击；曹操留下曹仁等守江陵城，自己向北撤回。此时江陵城由曹操留下的曹仁等守卫。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-72ec-833a-7907184f9945",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7571-8c71-79037f4c12d6",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7685-9d1d-b3a2e909c6ef",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7599-8eac-0d9bd9d4a086",
          "importance": "other"
        }
      ],
      "id": "para_nan_battle",
      "phase_id": "p_nan_battle",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_021",
            "conclusion_022",
            "added_caoren_allegiance"
          ],
          "event_id": "01a09988-8a05-76da-8351-5ac685db50c5",
          "event_relation": "current",
          "event_text": null,
          "text": "周瑜、程普继续进军南郡，与曹仁隔江对峙。周瑜先派甘宁据守夷陵，曹仁分兵围攻，甘宁告急。周瑜采纳吕蒙之计，留下凌统守后方，自己与吕蒙救援甘宁。解围后，周瑜渡江屯在北岸，约定日期交战。他在交战中被流箭射中右胁，曹仁听闻其卧病后进逼军阵；周瑜起身巡视军营、激励将士，曹仁因此退兵。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a05-7dbd-86e9-d6f30006ec38",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7255-980c-bba704a589b6",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7939-b8a0-6d94e50c096b",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7583-9e05-73f0cba3c3dc",
          "importance": "other"
        }
      ],
      "id": "para_nan_office",
      "phase_id": "p_nan_office",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_023",
            "conclusion_024",
            "conclusion_025",
            "conclusion_026",
            "added_liubei_left",
            "added_liubei_jing",
            "added_sunquan_allegiance"
          ],
          "event_id": "01a09988-8a05-7e99-a199-75b2b72a2938",
          "event_relation": "current",
          "event_text": null,
          "text": "南郡战事后，孙权任命周瑜为偏将军，领南郡太守，并使其屯据江陵；下雋、汉昌、刘阳、州陵被列为其奉邑。周瑜领南郡太守、刘备到京见孙权这一时期，刘备以左将军身份兼领荆州牧，以公安为治所。周瑜还上疏建议把刘备安置在吴，以宫室、美人和玩好牵住他，再把关羽、张飞分置别处；孙权没有采纳。江陵在这一阶段由周瑜军屯据。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7074-a081-4db860a5cc2c",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a05-778c-9455-61adea93d74d",
          "importance": "other"
        },
