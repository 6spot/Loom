      ],
      "id": "para_shu_plan",
      "phase_id": "p_shu_plan",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_027",
            "conclusion_028",
            "conclusion_023",
            "conclusion_024",
            "added_yizhou_admin",
            "added_sunquan_allegiance"
          ],
          "event_id": "01a09988-8a05-7079-b424-e19f28b8c015",
          "event_relation": "current",
          "event_text": null,
          "text": "提出取蜀计划时，刘璋任益州牧，益州又受到张鲁侵扰。周瑜到京见孙权，认为曹操新败、正忧心内部，提出与称作“奋威”的将领共同进取蜀地，再兼并张鲁，留奋威守蜀、与马超结援；自己回来后与孙权据襄阳逼迫曹操，进图北方。孙权同意了这个方略。这里记载的是提议与许可，并未记作已经攻取益州。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a05-77c8-a276-abc41c6922ac",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a05-78e1-b7b4-0f7949c7dc06",
          "importance": "other"
        }
      ],
      "id": "para_death",
      "phase_id": "p_death",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_029",
            "added_baqiu"
          ],
          "event_id": "01a09988-8a05-7b07-aa75-2d2a4d1dc52e",
          "event_relation": "current",
          "event_text": null,
          "text": "周瑜返回江陵准备行装，途经巴丘时病逝，终年三十六岁。裴松之认为，病卒的巴丘应在他所说的巴陵，与周瑜早年镇守的巴丘同名而异地。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-7ef3-b965-c0e95db339f7",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a05-7947-8c00-b6837136a50c",
          "importance": "other"
        }
      ],
      "id": "para_mourning",
      "phase_id": "p_mourning",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_030"
          ],
          "event_id": "01a09988-8a05-7ed7-9280-dc8126a6d431",
          "event_relation": "current",
          "event_text": null,
          "text": "孙权穿素服为周瑜举哀，并在灵柩运回吴地途中到芜湖迎接，丧事所需费用由其供给。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-73d8-9b83-bb68c4a736be",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7287-a2c9-51c0cb7ef803",
          "importance": "other"
        }
      ],
      "id": "para_recollection",
      "phase_id": "p_recollection",
      "segments": [
        {
          "conclusion_ids": [
            "added_personality",
            "added_jianggan",
            "added_music"
          ],
          "event_id": "01a09988-8a05-7a57-8357-d62635843945",
          "event_relation": "background",
          "event_text": null,
          "text": "周瑜性情宽宏，大多能得到人心，早先与程普关系不睦。《江表传》说，程普仗着年长屡次凌辱周瑜，周瑜谦让而不计较，程普后来敬服他，说与周公瑾交往如饮醇酒，不知不觉便醉了。另据《江表传》，曹操派蒋干拜访周瑜，周瑜以自己与知己之主的君臣、骨肉之恩相答，蒋干最终未能游说，回去后称赞周瑜气度高远。周瑜年轻时还精于音乐，即使饮酒后也能听出演奏差错，因此有“曲有误，周郎顾”的歌谣。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7bc5-acab-85c120ead68e",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7d7b-b494-7994fe35b6c0",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7e20-b640-068fd30eb1f8",
          "importance": "other"
        }
      ],
      "id": "para_family",
      "phase_id": "p_family",
      "segments": [
        {
          "conclusion_ids": [
            "added_children"
          ],
          "event_id": null,
          "event_relation": null,
          "event_text": null,
          "text": "周瑜有两个儿子和一个女儿，女儿嫁给太子孙登，长子周循娶了公主。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-7d7b-b494-7994fe35b6c0",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a05-7004-b67a-5888d1e943b4",
