          ],
          "event_id": "01a09988-8a05-7333-be5c-e58cc021f689",
          "event_relation": "current",
          "event_text": null,
          "text": "周瑜的侄子周峻因周瑜的功勋获任偏将军，统领一千名吏士。"
        }
      ]
    },
