{
  "entry_points": [
    {
      "event_id": "01a09988-8a05-78c2-a79a-c221b37aa310",
      "kind": "event",
      "label": "随孙策渡江与东进",
      "paragraph_id": "para_east",
      "reason": "展示周瑜迎接孙策、参与连续征战并返回丹杨的完整早期军事转折。"
    },
    {
      "event_id": "01a09988-8a05-70b2-8d48-68154f401aba",
      "kind": "event",
      "label": "赤壁交战",
      "paragraph_id": "para_redcliff",
      "reason": "集中呈现抗曹决策后的联军形成、火攻过程与曹军败退，是全章最重要的军事转折。"
    },
    {
      "event_id": null,
      "kind": "period",
      "label": "南郡作战与江陵屯据",
      "paragraph_id": "para_nan_battle",
      "reason": "涵盖赤壁之后围绕夷陵、江陵展开的救援、受伤、退兵及随后驻军和任职变化。"
    },
    {
      "event_id": "01a09988-8a05-7079-b424-e19f28b8c015",
      "kind": "event",
      "label": "取蜀方略",
      "paragraph_id": "para_shu_plan",
      "reason": "呈现周瑜在南郡任职后提出的西进计划及其未及实施即因病身故的前兆。"
    },
    {
      "event_id": null,
      "kind": "period",
      "label": "周瑜病卒与身后家属",
      "paragraph_id": "para_death",
      "reason": "从病卒、孙权治丧延伸至周胤、周峻等家属后续，覆盖周瑜影响的身后发展。"
    }
  ],
  "paragraphs": [
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7b3c-bb3a-6baef6f088db",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7a67-8b3e-cc77e061accf",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-72ca-a054-de3befe366aa",
          "importance": "other"
        }
      ],
      "id": "para_early",
      "phase_id": "p_early",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_001",
            "added_friendship"
          ],
          "event_id": "01a09988-8a05-7c42-837d-26bb2a8a3b9c",
          "event_relation": "background",
          "event_text": null,
          "text": "周瑜字公瑾，是庐江舒人，身材高大、相貌出众。父亲周异做过洛阳令，从祖父周景及周景之子周忠都曾任汉太尉。孙坚参加讨伐董卓的义军时，把家眷迁到舒；孙策与周瑜同年，二人尤其要好，周瑜还让出道南大宅给孙策居住，彼此互通有无。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7df6-8b51-6b914fba6f41",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a05-75e6-bfef-34f96d6e2772",
          "importance": "other"
        }
      ],
      "id": "para_visit",
      "phase_id": "p_visit",
      "segments": [
        {
          "conclusion_ids": [
            "added_visit"
          ],
          "event_id": null,
          "event_relation": null,
          "event_text": null,
          "text": "周瑜的从父周尚任丹杨太守，周瑜前往探望他。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7b3c-bb3a-6baef6f088db",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a05-745b-9dba-27ba44253591",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a05-7066-8de5-fbadc5e42e60",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a05-778b-a112-bd74bed64176",
          "importance": "other"
        }
      ],
      "id": "para_east",
      "phase_id": "p_east",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_002",
            "added_sunshang_office",
            "added_sunce_allegiance"
          ],
          "event_id": "01a09988-8a05-78c2-a79a-c221b37aa310",
          "event_relation": "current",
          "event_text": null,
          "text": "孙策准备渡江向东，到了历阳便派人通知周瑜，周瑜带兵前去迎接。随后他随孙策攻取横江、当利，在秣陵击败笮融和薛礼，又攻下湖孰、江乘，进军曲阿。刘繇败走，孙策部众增至数万人；孙策认为凭这些兵力足以攻取吴会、平定山越，便让周瑜返回丹杨驻守。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-74bf-a1f8-91f61ab4c42a",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7df6-8b51-6b914fba6f41",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7680-8cab-19472278de85",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "other"
        }
      ],
      "id": "para_shouchun",
      "phase_id": "p_shouchun",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_003"
          ],
          "event_id": "01a09988-8a05-7b7f-94e7-5de23998e327",
          "event_relation": "current",
          "event_text": null,
          "text": "周瑜还镇丹杨不久，袁术派从弟袁胤代周尚为丹杨太守，周瑜与周尚一同回到寿春。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7680-8cab-19472278de85",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-78de-8104-97f65e5f5404",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a05-77f1-9361-74778644f71d",
          "importance": "other"
        }
      ],
      "id": "para_juchao",
      "phase_id": "p_juchao",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_004"
          ],
          "event_id": "01a09988-8a05-766c-8ebb-edc7362b1745",
          "event_relation": "current",
          "event_text": null,
          "text": "袁术想让周瑜做将领，周瑜认为袁术最终不会有所成就，便请求担任居巢长，打算借道东归，袁术答应了。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7b3c-bb3a-6baef6f088db",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a05-71ee-bb4f-73cbfe46a8b7",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-76b6-b3dd-02065071eaef",
          "importance": "other"
        }
      ],
      "id": "para_return",
      "phase_id": "p_return",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_005",
            "added_sunce_allegiance"
          ],
          "event_id": "01a09988-8a05-7ba7-94ab-412da1ee11b7",
          "event_relation": "current",
          "event_text": null,
          "text": "建安三年，周瑜从居巢回到吴地。孙策亲自迎接，授他建威中郎将，给兵二千、骑五十。周瑜当时二十四岁，吴地人称他为“周郎”。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7ded-a1a3-d21da3436bf7",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-76b6-b3dd-02065071eaef",
          "importance": "other"
        }
      ],
      "id": "para_niuzhu",
      "phase_id": "p_niuzhu",
      "segments": [
        {
          "conclusion_ids": [
            "added_niuzhu",
            "added_sunce_allegiance"
          ],
          "event_id": null,
          "event_relation": null,
          "event_text": null,
          "text": "周瑜在庐江素有恩信，于是被派出镇守牛渚。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a05-7ef5-ac88-f4109e7452a9",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7b3c-bb3a-6baef6f088db",
          "importance": "other"
        }
      ],
      "id": "para_chungu",
      "phase_id": "p_chungu",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_006",
            "added_sunce_allegiance"
          ],
          "event_id": null,
          "event_relation": null,
          "event_text": null,
          "text": "出镇牛渚以后，周瑜领春谷长。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7b3c-bb3a-6baef6f088db",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a05-7947-8c00-b6837136a50c",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a05-796d-b8bd-6b88491754fe",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-722f-b27a-cdb9244c7d3d",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-70f0-a1ee-4331f840676c",
          "importance": "other"
        }
      ],
      "id": "para_wan",
      "phase_id": "p_wan",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_007",
            "conclusion_008",
            "added_wan_campaign",
            "added_sunce_allegiance"
          ],
          "event_id": "01a09988-8a05-791a-94e6-8aba97619b26",
          "event_relation": "current",
          "event_text": null,
          "text": "孙策准备进取荆州，任命周瑜为中护军。周瑜随孙策攻克皖；此后又到寻阳附近击败刘勋，进讨江夏，返回平定豫章、庐陵，留下镇守巴丘。这一时期的底本在任中护军后紧接写有“領導江夏太守”，可能还涉及兼领江夏太守，但文字有疑；裴松之又指出，当时孙策尚未定江夏。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-7ef3-b965-c0e95db339f7",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7a15-bea9-d911f3d3a41e",
          "importance": "other"
        }
      ],
      "id": "para_sunquan",
      "phase_id": "p_sunquan",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_009",
            "conclusion_010",
            "added_zhangzhao_office",
            "added_sunquan_allegiance"
          ],
          "event_id": "01a09988-8a05-7c21-81bb-dcc0a86be487",
          "event_relation": "current",
          "event_text": null,
          "text": "建安五年孙策去世，孙权接掌政事。周瑜率兵赶去奔丧，随后留在吴，以中护军身份与长史张昭共同掌管众事。此时周瑜对孙权恪守臣礼，明确在孙权麾下掌事。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7ef3-b965-c0e95db339f7",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7b86-b16d-9f6904ea6a0d",
          "importance": "other"
        }
      ],
      "id": "para_hostage",
      "phase_id": "p_hostage",
      "segments": [
        {
          "conclusion_ids": [
            "added_hostage"
          ],
          "event_id": null,
          "event_relation": null,
          "event_text": null,
          "text": "据《江表传》，建安七年曹操要求孙权送子弟为人质。周瑜认为，一旦送质，孙权便会受曹氏制约，不如守住父兄留下的基业、静观局势。孙权的母亲赞同周瑜，劝孙权像对待兄长一样对待他，孙权于是没有送质。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a05-7023-a43a-24386bab97bb",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7cf8-902e-8188c701380d",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7db3-9cee-a880cc7b34fa",
          "importance": "other"
        }
      ],
      "id": "para_206",
      "phase_id": "p_206",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_011",
            "conclusion_012",
            "added_huangzu_office"
          ],
          "event_id": "01a09988-8a05-7759-908d-e3144f463437",
          "event_relation": "current",
          "event_text": null,
          "text": "建安十一年，周瑜督率孙瑜等讨伐麻、保二屯，斩其首领并俘获一万余人。随后，江夏太守黄祖派邓龙率数千人进入柴桑，周瑜追击并生擒邓龙，送往吴地。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7ef3-b965-c0e95db339f7",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-722f-b27a-cdb9244c7d3d",
          "importance": "other"
        }
      ],
      "id": "para_spring",
      "phase_id": "p_spring",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_013",
            "added_sunquan_allegiance"
          ],
          "event_id": "01a09988-8a05-7314-ac73-7656c50c3cb1",
          "event_relation": "current",
          "event_text": null,
          "text": "建安十三年春，孙权进攻江夏，周瑜担任前部大督。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-7b86-b16d-9f6904ea6a0d",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7288-8dff-1b8cb96a93b6",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7160-911f-c7d19e9fd7b0",
          "importance": "other"
        }
      ],
      "id": "para_jingzhou",
      "phase_id": "p_jingzhou",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_014"
          ],
          "event_id": "01a09988-8a05-797d-a14d-8c960eee4b10",
          "event_relation": "background",
          "event_text": null,
          "text": "同年九月，曹操进入荆州，刘琮率众投降。曹操取得刘表的水军，水陆兵力号称数十万，孙权部下听说后十分恐惧。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7ef3-b965-c0e95db339f7",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7b86-b16d-9f6904ea6a0d",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7017-8abc-0120e4b98b77",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7f49-be73-430a032d3a4a",
          "importance": "other"
        }
      ],
      "id": "para_decision",
      "phase_id": "p_decision",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_015",
            "conclusion_016",
            "conclusion_017",
            "added_caocao_title",
            "added_jiangdong_control",
            "added_sunquan_allegiance"
          ],
          "event_id": "01a09988-8a05-7447-80a5-f8b8f8193235",
          "event_relation": "current",
          "event_text": null,
          "text": "孙权召集部属问计，群臣认为曹操借汉廷名义征伐，又得到荆州水军，长江之险已不足独恃，主张迎降。周瑜反对，指出曹操北方未稳，马超、韩遂仍在关西；北军不长于水战，严寒中马缺饲草，远来将士也容易因水土不服患病。他请求精兵三万人进驻夏口，迎击曹军。孙权赞同周瑜的意见。裴松之认为，抗曹之计实际先由鲁肃提出；本传虽集中记载周瑜的抗战主张，却不能据此否定鲁肃此前的谋划。"
        }
      ]
    },
    {
      "entities": [
        {
          "entity_id": "01a09988-8a04-7255-980c-bba704a589b6",
          "importance": "primary"
        },
        {
          "entity_id": "01a09988-8a04-7017-8abc-0120e4b98b77",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-79c6-999d-3f2c12f7b6b3",
          "importance": "other"
        },
        {
          "entity_id": "01a09988-8a04-7e50-afab-197dfc655716",
          "importance": "other"
        }
      ],
      "id": "para_redcliff_intro",
      "phase_id": "p_decision",
      "segments": [
        {
          "conclusion_ids": [
            "conclusion_018"
          ],
          "event_id": "01a09988-8a05-74cd-8fd9-c41437a5a535",
          "event_relation": "current",
          "event_text": null,
          "text": "刘备被曹操击败后，在当阳与鲁肃相遇，共同商议对策，随后进驻夏口，派诸葛亮前去拜见孙权。"
        }
      ]
    },
    {
      "entities": [
        {
