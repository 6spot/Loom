        "id": "para_yin_petition",
        "phase_id": "p_yin_petition",
        "segments": [
          {
            "text": "赤乌二年，诸葛瑾、步骘联名上疏，请孙权顾念周瑜冒矢石、击败曹操和曹仁的功劳，宽免周胤，恢复兵权与爵位。他们援引汉高祖封爵誓言，主张功臣后裔也应得到照顾。",
            "conclusion_ids": [
              "conclusion_033"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null
          },
          {
            "text": "奏疏说，周胤已经“降为匹夫”。",
            "conclusion_ids": [
              "added_yin_loss"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null
          },
          {
            "text": "孙权答复说，自己并未忘记周瑜，只因周胤屡经告诫仍不改过，暂不愿立即恢复；如果能改过，仍有余地。",
            "conclusion_ids": [
              "conclusion_033"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null
          }
        ]
