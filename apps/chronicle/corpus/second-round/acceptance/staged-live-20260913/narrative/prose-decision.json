        "id": "para_retreat",
        "phase_id": "p_retreat",
        "segments": [
          {
            "text": "曹军退保南郡，刘备与周瑜等继续追击。曹操留下曹仁等守江陵城，自己向北撤回。",
            "conclusion_ids": [
              "conclusion_020",
              "added_jiangling_before",
              "added_caoren_allegiance"
            ],
            "event_id": "01a09988-8a05-7251-8d1f-0376547e08fb",
            "event_relation": "current",
            "event_text": null
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
