          },
          {
            "entity_id": "01a09988-8a04-7583-9e05-73f0cba3c3dc",
            "importance": "other"
          }
        ],
        "id": "para_nan_office",
        "phase_id": "p_nan_office",
        "segments": [
          {
            "text": "南郡战事后，孙权任命周瑜为偏将军，领南郡太守，给他下雋、汉昌、刘阳、州陵四县作为奉邑，军队屯据江陵。",
            "conclusion_ids": [
              "conclusion_023",
              "conclusion_024",
              "conclusion_025"
            ],
            "event_id": "01a09988-8a05-7e99-a199-75b2b72a2938",
            "event_relation": "current",
            "event_text": null
          },
          {
            "text": "刘备此时以左将军身份兼领荆州牧，以公安为治所。他到京拜见孙权，周瑜上疏建议把他安置在吴，以宫室、美人和玩好牵住他，再把关羽、张飞分置别处，让将领统领征战。周瑜担心三人聚在一起、又得到土地，便难以约束。孙权考虑曹操仍在北方，需要广纳英雄，又担心难以突然控制刘备，没有采纳。",
            "conclusion_ids": [
              "added_liubei_left",
              "added_liubei_jing",
              "conclusion_026"
            ],
            "event_id": "01a09988-8a05-7ba8-8603-69f6db752128",
            "event_relation": "current",
            "event_text": null
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7ef3-b965-c0e95db339f7",
            "importance": "primary"
          },
          {
