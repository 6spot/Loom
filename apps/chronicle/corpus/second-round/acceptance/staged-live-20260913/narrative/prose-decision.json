{
  "candidate_sha": "7e62fc741c56a63b4df91e81f23ba0fba72c33f60e2d13c78de5000f57118907",
  "decision": "approve",
  "content": {
    "entry_points": [
      {
        "label": "孙策渡江与江东的兴起",
        "kind": "event",
        "paragraph_id": "para_east",
        "event_id": "01a09988-8a05-78c2-a79a-c221b37aa310",
        "reason": "从渡江切入孙策经营江东及周瑜的早期经历，继续阅读仍通向后续历史。"
      },
      {
        "label": "赤壁之战",
        "kind": "event",
        "paragraph_id": "para_redcliff",
        "event_id": "01a09988-8a05-70b2-8d48-68154f401aba",
        "reason": "联军迎击与火攻是本次叙事的主要转折；入口定位实际交战段，战前商议及战后发展都保留可读。"
      },
      {
        "label": "南郡争夺",
        "kind": "period",
        "paragraph_id": "para_nan_battle",
        "event_id": null,
        "reason": "连接夷陵救援、周瑜受伤、曹仁退兵与江陵任职，展示赤壁后荆州局势的发展，不为每次任免另设入口。"
      }
    ],
    "paragraphs": [
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7b3c-bb3a-6baef6f088db",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7a67-8b3e-cc77e061accf",
            "importance": "other"
          },
          {
            "entity_id": "01a09988-8a04-72ca-a054-de3befe366aa",
            "importance": "other"
          }
        ],
        "id": "para_early",
        "phase_id": "p_early",
        "segments": [
          {
            "text": "周瑜字公瑾，是庐江舒人，身材高大、相貌出众。父亲周异做过洛阳令，从祖父周景及周景之子周忠都曾任汉太尉。孙坚参加讨伐董卓的义军时，把家眷迁到舒。孙策与周瑜同年，二人尤其要好；周瑜让出道南大宅给孙策居住，彼此以家人般的礼节相待，互通有无。",
            "conclusion_ids": [
              "conclusion_001",
              "added_friendship"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7df6-8b51-6b914fba6f41",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-75e6-bfef-34f96d6e2772",
            "importance": "other"
          }
        ],
        "id": "para_visit",
        "phase_id": "p_visit",
        "segments": [
          {
            "conclusion_ids": [
              "added_visit"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null,
            "text": "周瑜的从父周尚任丹杨太守，周瑜前往探望他。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7b3c-bb3a-6baef6f088db",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7d2a-a186-50c8ee1d1329",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-745b-9dba-27ba44253591",
            "importance": "other"
          },
          {
            "entity_id": "01a09988-8a05-7066-8de5-fbadc5e42e60",
            "importance": "other"
          },
          {
            "entity_id": "01a09988-8a05-778b-a112-bd74bed64176",
            "importance": "other"
          }
        ],
        "id": "para_east",
        "phase_id": "p_east",
        "segments": [
          {
            "text": "孙策准备渡江东进，周瑜在历阳带兵迎接。随后，他随孙策攻取横江、当利，在秣陵击败笮融、薛礼，又攻下湖孰、江乘，进军曲阿。刘繇败走，孙策部众增至数万人。孙策认为凭这些兵力足以攻取吴会、平定山越，便让周瑜返回丹杨驻守。",
            "conclusion_ids": [
              "conclusion_002",
              "added_sunce_allegiance"
            ],
            "event_id": "01a09988-8a05-78c2-a79a-c221b37aa310",
            "event_relation": "current",
            "event_text": "渡江东进"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7df6-8b51-6b914fba6f41",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7680-8cab-19472278de85",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-74bf-a1f8-91f61ab4c42a",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7d2a-a186-50c8ee1d1329",
            "importance": "primary"
          }
        ],
        "id": "para_shouchun",
        "phase_id": "p_shouchun",
        "segments": [
          {
            "conclusion_ids": [
              "conclusion_003"
            ],
            "event_id": "01a09988-8a05-7b7f-94e7-5de23998e327",
            "event_relation": "current",
            "event_text": null,
            "text": "周瑜还镇丹杨不久，袁术派从弟袁胤代周尚为丹杨太守，周瑜与周尚一同回到寿春。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7680-8cab-19472278de85",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-78de-8104-97f65e5f5404",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-77f1-9361-74778644f71d",
            "importance": "other"
          }
        ],
        "id": "para_juchao",
        "phase_id": "p_juchao",
        "segments": [
          {
            "conclusion_ids": [
              "conclusion_004"
            ],
            "event_id": "01a09988-8a05-766c-8ebb-edc7362b1745",
            "event_relation": "current",
            "event_text": null,
            "text": "袁术想让周瑜做将领，周瑜认为袁术最终不会有所成就，便请求担任居巢长，打算借道东归，袁术答应了。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7b3c-bb3a-6baef6f088db",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-76b6-b3dd-02065071eaef",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-71ee-bb4f-73cbfe46a8b7",
            "importance": "other"
          }
        ],
        "id": "para_return",
        "phase_id": "p_return",
        "segments": [
          {
            "conclusion_ids": [
              "conclusion_005",
              "added_sunce_allegiance"
            ],
            "event_id": "01a09988-8a05-7ba7-94ab-412da1ee11b7",
            "event_relation": "current",
            "event_text": null,
            "text": "建安三年，周瑜从居巢回到吴地。孙策亲自迎接，授他建威中郎将，给兵二千、骑五十。周瑜当时二十四岁，吴地人称他为“周郎”。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7ded-a1a3-d21da3436bf7",
            "importance": "other"
          },
          {
            "entity_id": "01a09988-8a04-76b6-b3dd-02065071eaef",
            "importance": "other"
          }
        ],
        "id": "para_niuzhu",
        "phase_id": "p_niuzhu",
        "segments": [
          {
            "conclusion_ids": [
              "added_niuzhu",
              "added_sunce_allegiance"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null,
            "text": "周瑜在庐江素有恩信，于是被派出镇守牛渚。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-7ef5-ac88-f4109e7452a9",
            "importance": "other"
          },
          {
            "entity_id": "01a09988-8a04-7b3c-bb3a-6baef6f088db",
            "importance": "other"
          }
        ],
        "id": "para_chungu",
        "phase_id": "p_chungu",
        "segments": [
          {
            "conclusion_ids": [
              "conclusion_006",
              "added_sunce_allegiance"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null,
            "text": "出镇牛渚以后，周瑜领春谷长。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7b3c-bb3a-6baef6f088db",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-722f-b27a-cdb9244c7d3d",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-7947-8c00-b6837136a50c",
            "importance": "other"
          },
          {
            "entity_id": "01a09988-8a05-796d-b8bd-6b88491754fe",
            "importance": "other"
          },
          {
            "entity_id": "01a09988-8a04-70f0-a1ee-4331f840676c",
            "importance": "other"
          }
        ],
        "id": "para_wan",
        "phase_id": "p_wan",
        "segments": [
          {
            "text": "孙策准备进取荆州，任命周瑜为中护军。周瑜随孙策攻克皖，孙策娶了桥公的长女，周瑜娶了次女。此后，他们又在寻阳附近击败刘勋，进讨江夏，返回平定豫章、庐陵，周瑜留下镇守巴丘。",
            "conclusion_ids": [
              "conclusion_007",
              "added_wan_campaign",
              "added_sunce_allegiance"
            ],
            "event_id": "01a09988-8a05-791a-94e6-8aba97619b26",
            "event_relation": "current",
            "event_text": null
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-7ef3-b965-c0e95db339f7",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7a15-bea9-d911f3d3a41e",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-76b6-b3dd-02065071eaef",
            "importance": "primary"
          }
        ],
        "id": "para_sunquan",
        "phase_id": "p_sunquan",
        "segments": [
          {
            "text": "建安五年孙策去世，孙权接掌政事。周瑜率兵赶去奔丧，随后留在吴，以中护军身份与长史张昭共同处理事务，对孙权恪守臣礼。",
            "conclusion_ids": [
              "conclusion_009",
              "conclusion_010",
              "added_zhangzhao_office",
              "added_sunquan_allegiance"
            ],
            "event_id": "01a09988-8a05-7c21-81bb-dcc0a86be487",
            "event_relation": "current",
            "event_text": null
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7ef3-b965-c0e95db339f7",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7b86-b16d-9f6904ea6a0d",
            "importance": "other"
          }
        ],
        "id": "para_hostage",
        "phase_id": "p_hostage",
        "segments": [
          {
            "conclusion_ids": [
              "added_hostage"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null,
            "text": "据《江表传》，建安七年曹操要求孙权送子弟为人质。周瑜认为，一旦送质，孙权便会受曹氏制约，不如守住父兄留下的基业、静观局势。孙权的母亲赞同周瑜，劝孙权像对待兄长一样对待他，孙权于是没有送质。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7cf8-902e-8188c701380d",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-789f-a40e-92e971f768ab",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-7023-a43a-24386bab97bb",
            "importance": "other"
          },
          {
            "entity_id": "01a09988-8a04-7db3-9cee-a880cc7b34fa",
            "importance": "other"
          }
        ],
        "id": "para_206",
        "phase_id": "p_206",
        "segments": [
          {
            "conclusion_ids": [
              "conclusion_011",
              "conclusion_012",
              "added_huangzu_office"
            ],
            "event_id": "01a09988-8a05-7759-908d-e3144f463437",
            "event_relation": "current",
            "event_text": null,
            "text": "建安十一年，周瑜督率孙瑜等讨伐麻、保二屯，斩其首领并俘获一万余人。随后，江夏太守黄祖派邓龙率数千人进入柴桑，周瑜追击并生擒邓龙，送往吴地。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7ef3-b965-c0e95db339f7",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-722f-b27a-cdb9244c7d3d",
            "importance": "primary"
          }
        ],
        "id": "para_spring",
        "phase_id": "p_spring",
        "segments": [
          {
            "conclusion_ids": [
              "conclusion_013",
              "added_sunquan_allegiance"
            ],
            "event_id": "01a09988-8a05-7314-ac73-7656c50c3cb1",
            "event_relation": "current",
            "event_text": null,
            "text": "建安十三年春，孙权进攻江夏，周瑜担任前部大督。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-7b86-b16d-9f6904ea6a0d",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7288-8dff-1b8cb96a93b6",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7160-911f-c7d19e9fd7b0",
            "importance": "primary"
          }
        ],
        "id": "para_jingzhou",
        "phase_id": "p_jingzhou",
        "segments": [
          {
            "text": "同年九月，曹操进入荆州，刘琮率众投降。曹操取得他的水军，水陆兵力号称数十万，孙权部下听说后十分恐惧。",
            "conclusion_ids": [
              "conclusion_014"
            ],
            "event_id": "01a09988-8a05-797d-a14d-8c960eee4b10",
            "event_relation": "current",
            "event_text": null
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7ef3-b965-c0e95db339f7",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7b86-b16d-9f6904ea6a0d",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7017-8abc-0120e4b98b77",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7255-980c-bba704a589b6",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-79c6-999d-3f2c12f7b6b3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-7520-935e-7d8d5e60de82",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7e50-afab-197dfc655716",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7f49-be73-430a032d3a4a",
            "importance": "other"
          }
        ],
        "id": "para_decision",
        "phase_id": "p_decision",
        "segments": [
          {
            "text": "孙权召集部属问计。群臣认为曹操借汉廷名义征伐，又得到荆州水军，长江之险已不足独恃，主张迎降。周瑜反对，指出曹操北方未稳，马超、韩遂仍在关西；北军不长于水战，严寒中马缺饲草，远来将士也容易因水土不服患病。他请求精兵三万人进驻夏口，迎击曹军。孙权赞同这个意见。",
            "conclusion_ids": [
              "conclusion_015",
              "conclusion_016"
            ],
            "event_id": "01a09988-8a05-7447-80a5-f8b8f8193235",
            "event_relation": "current",
            "event_text": null
          },
          {
            "text": "裴松之认为，抗曹之计先由鲁肃提出；鲁肃劝孙权召回出使鄱阳的周瑜，周瑜回来后，两人的意见不谋而合。",
            "conclusion_ids": [
              "conclusion_017"
            ],
            "event_id": "01a09988-8a05-7447-80a5-f8b8f8193235",
            "event_relation": "current",
            "event_text": null
          },
          {
            "text": "据《江表传》，孙权备好了三万人的船粮军资，让周瑜、鲁肃、程普先行，自己接续发兵运粮，作为后援。",
            "conclusion_ids": [
              "conclusion_016"
            ],
            "event_id": "01a09988-8a05-7447-80a5-f8b8f8193235",
            "event_relation": "current",
            "event_text": null
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7ef3-b965-c0e95db339f7",
            "importance": "primary"
          },
          {
