            "entity_id": "01a09988-8a04-7f49-be73-430a032d3a4a",
            "importance": "other"
          }
        ],
        "id": "para_shu_plan",
        "phase_id": "p_shu_plan",
        "segments": [
          {
            "text": "当时刘璋任益州牧，益州受到张鲁侵扰。周瑜到京见孙权，认为曹操新败，正忧心内部，便提出与称作“奋威”的将领共同进取蜀地，再兼并张鲁，留奋威守蜀、与马超结援；自己回来后与孙权据襄阳逼迫曹操，进图北方。孙权同意了这个方略。",
            "conclusion_ids": [
              "conclusion_027",
              "conclusion_028",
              "added_yizhou_admin"
            ],
            "event_id": "01a09988-8a05-7079-b424-e19f28b8c015",
            "event_relation": "current",
            "event_text": null
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-77c8-a276-abc41c6922ac",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-78e1-b7b4-0f7949c7dc06",
            "importance": "other"
          }
        ],
        "id": "para_death",
        "phase_id": "p_death",
        "segments": [
          {
            "text": "周瑜返回江陵准备行装，途经巴丘时病逝，终年三十六岁。",
            "conclusion_ids": [
              "conclusion_029"
            ],
            "event_id": "01a09988-8a05-7b07-aa75-2d2a4d1dc52e",
            "event_relation": "current",
            "event_text": null
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-7ef3-b965-c0e95db339f7",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-7947-8c00-b6837136a50c",
            "importance": "primary"
          }
        ],
        "id": "para_mourning",
        "phase_id": "p_mourning",
        "segments": [
          {
            "conclusion_ids": [
              "conclusion_030"
            ],
            "event_id": "01a09988-8a05-7ed7-9280-dc8126a6d431",
            "event_relation": "current",
            "event_text": null,
            "text": "孙权穿素服为周瑜举哀，并在灵柩运回吴地途中到芜湖迎接，丧事所需费用由其供给。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-73d8-9b83-bb68c4a736be",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7287-a2c9-51c0cb7ef803",
            "importance": "primary"
          }
        ],
        "id": "para_recollection",
        "phase_id": "p_recollection",
        "segments": [
          {
            "text": "周瑜生前性情宽宏，大多能得到他人的好感，却一度与程普关系不睦。《江表传》说，程普仗着年长屡次凌辱周瑜，周瑜谦让而不计较。程普后来敬服他，说与周公瑾交往如饮醇酒，不知不觉便醉了。",
            "conclusion_ids": [
              "added_personality"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null
          },
          {
            "text": "《江表传》还记下蒋干拜访周瑜的一段往事。蒋干受曹操派遣而来，周瑜招待他，又带他观看营中军资器械，表示自己与知己之主外有君臣之义、内有骨肉之恩，不会因游说改变。蒋干回去后称赞周瑜气度高远，言辞无法离间。",
            "conclusion_ids": [
              "added_jianggan"
            ],
            "event_id": "01a09988-8a05-7a57-8357-d62635843945",
            "event_relation": "retrospective",
            "event_text": null
          },
          {
            "text": "周瑜从年轻时就精于音乐，即使喝过几杯酒，也能听出演奏中的差错，一听出来便回头看，因此有“曲有误，周郎顾”的歌谣。",
            "conclusion_ids": [
              "added_music"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7d7b-b494-7994fe35b6c0",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7bc5-acab-85c120ead68e",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a04-7e20-b640-068fd30eb1f8",
            "importance": "other"
          }
        ],
        "id": "para_family",
        "phase_id": "p_family",
        "segments": [
          {
            "text": "周瑜的家属也与孙氏有着紧密联系。他有两个儿子和一个女儿，女儿嫁给太子孙登，长子周循娶了公主。",
            "conclusion_ids": [
              "added_children"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-7d7b-b494-7994fe35b6c0",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-7004-b67a-5888d1e943b4",
            "importance": "other"
          },
          {
            "entity_id": "01a09988-8a04-71a3-b62d-ac6fb3673ba3",
            "importance": "other"
          }
        ],
        "id": "para_xun",
        "phase_id": "p_xun",
        "segments": [
          {
            "conclusion_ids": [
              "added_xun_office"
            ],
            "event_id": "01a09988-8a05-7433-adba-5bfba9368d71",
            "event_relation": "current",
            "event_text": null,
            "text": "周循获任骑都尉，颇有周瑜的风范。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-7d7b-b494-7994fe35b6c0",
            "importance": "primary"
          }
        ],
        "id": "para_xun_death",
        "phase_id": "p_xun_death",
        "segments": [
          {
            "conclusion_ids": [
              "added_xun_death"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null,
            "text": "周循早逝。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-7e20-b640-068fd30eb1f8",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-78e1-b7b4-0f7949c7dc06",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-743e-9ce8-79c5a3e52055",
            "importance": "other"
          }
        ],
        "id": "para_yin_initial",
        "phase_id": "p_yin_initial",
        "segments": [
          {
            "conclusion_ids": [
              "conclusion_031"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null,
            "text": "周胤起初拜兴业都尉，娶宗室女子为妻，获授一千名士兵并屯驻公安。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-7e20-b640-068fd30eb1f8",
            "importance": "primary"
          },
          {
            "entity_id": "01a09988-8a05-73ef-92a9-b308de72d1af",
            "importance": "other"
          }
        ],
        "id": "para_yin_title",
        "phase_id": "p_yin_title",
        "segments": [
          {
            "conclusion_ids": [
              "conclusion_032"
            ],
            "event_id": "01a09988-8a05-7c40-8d92-056fdd8507f3",
            "event_relation": "current",
            "event_text": null,
            "text": "黄龙元年，周胤受封都乡侯。"
          }
        ]
      },
      {
        "entities": [
          {
            "entity_id": "01a09988-8a04-7e20-b640-068fd30eb1f8",
            "importance": "primary"
          }
        ],
        "id": "para_yin_exile",
        "phase_id": "p_yin_exile",
        "segments": [
          {
            "conclusion_ids": [
              "added_yin_exile"
            ],
            "event_id": null,
            "event_relation": null,
            "event_text": null,
            "text": "周胤受封以后，因罪被迁到庐陵郡。"
          }
        ]
      },
      {
