    "decisions": [
      {
        "finding_refs": [
          "review-luna/f_001",
          "review-sol/i_005"
        ],
        "disposition": "supported",
        "explanation": "两项意见指向同一处人物关系错误。原文“靈等”承接前文曹操派先主督领的朱灵、路招等人，并非关羽等人；译文将其译为“关羽等人回来”，改变了行动者。",
        "source_evidence": [
          {
            "first_block_id": "b_017",
            "last_block_id": "b_017",
            "quote": "先主據下邳。靈等還，先主乃殺徐州刺史車冑，留關羽守下邳，而身還小沛。",
            "occurrence": 1
          }
        ],
        "translation_ids": [
          "t_010"
        ],
        "suggested_change": "改为“先主占据下邳。朱灵等人返回后，先主于是杀死徐州刺史车胄……”"
      },
      {
        "finding_refs": [
          "review-luna/f_002",
          "review-sol/i_006"
        ],
        "disposition": "supported",
        "explanation": "两项意见指向同一处关系遗漏。“先主故茂才也”说明袁谭过去是先主举荐的茂才，译文遗漏了举荐者先主。",
        "source_evidence": [
          {
            "first_block_id": "b_019",
            "last_block_id": "b_019",
            "quote": "先主走青州。青州刺史袁譚，先主故茂才也，將步騎迎先主。",
            "occurrence": 1
          }
        ],
        "translation_ids": [
          "t_011"
        ],
        "suggested_change": "改为“青州刺史袁谭，过去曾被先主举荐为茂才，他率领步兵、骑兵迎接先主。”"
      },
      {
        "finding_refs": [
          "review-luna/f_003"
        ],
        "disposition": "supported",
        "explanation": "“亡者日多”中的“亡者”指死亡者日益增多，不是士卒逃亡。译文将战死或死亡误译为逃亡，改变了战况。",
        "source_evidence": [
          {
            "first_block_id": "b_043",
            "last_block_id": "b_043",
            "quote": "及曹公至，先主斂眾拒險，終不交鋒，積月不拔，亡者日多。",
            "occurrence": 1
          }
        ],
        "translation_ids": [
          "t_024"
        ],
        "suggested_change": "改为“曹操到达后，先主收拢部众据险防守，始终不与他交锋；相持数月而不能攻破，死亡的人日益增多。”"
      },
      {
        "finding_refs": [
          "review-sol/i_001"
        ],
        "disposition": "supported",
        "explanation": "“義兵”是义军、义兵，结合后文“討黃巾賊”，这里不是响应黄巾起事。译文“举兵响应”改变了各州郡与黄巾军的关系。",
        "source_evidence": [
          {
            "first_block_id": "b_009",
            "last_block_id": "b_009",
            "quote": "靈帝末，黃巾起，州郡各舉義兵，先主率其屬從校尉鄒靖討黃巾賊有功，除安喜尉。",
            "occurrence": 1
          }
        ],
        "translation_ids": [
          "t_004"
        ],
        "suggested_change": "改为“灵帝末年，黄巾军起事，各州郡纷纷举起义兵。”"
      },
      {
        "finding_refs": [
          "review-sol/i_002"
        ],
        "disposition": "unsupported",
        "explanation": "“將至沛收散卒”按原文可理解为先主将到沛县时收集散卒；后面的“給其軍糧，益與兵”也可承接曹操对先主的供给。译文并未形成报告所称的明确错误，建议的“曹操派他到沛县”超出了这句原文的明确内容。",
        "source_evidence": [
          {
            "first_block_id": "b_013",
            "last_block_id": "b_013",
            "quote": "曹公厚遇之，以為豫州牧。將至沛收散卒，給其軍糧，益與兵使東擊布。",
            "occurrence": 1
          }
        ],
        "translation_ids": [
          "t_008"
        ],
        "suggested_change": null
      },
      {
