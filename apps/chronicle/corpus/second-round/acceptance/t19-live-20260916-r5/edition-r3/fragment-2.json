  "paragraphs": [
    {
      "entities": [],
      "id": "r3-p000-part-2",
      "ordinal": 0,
      "phase_id": "r3-phase-2",
      "segments": [
        {
          "conclusion_ids": [
            "r3-c000-part-2"
          ],
          "event_id": "evt_000012",
          "event_relation": "current",
          "text": "孙权任命周瑜为偏将军，兼任南郡太守，把下隽、汉昌、刘阳、州陵划为他的奉邑，驻军占据江陵。刘备以左将军的身份兼任荆州牧，治所设在公安。刘备到京城拜见孙权，周瑜上书说：“刘备具有枭雄的气质，又有关羽、张飞这样如熊似虎的将领，必然不会长久屈居人下、受人驱使。我认为，从长远大计考虑，应该把刘备迁到吴地，为他大规模修建宫室，给他安排许多美女和珍玩，使他沉溺于声色享乐；再把关羽、张飞两人分开，各自安置在一方，让像我这样的人能够挟制他们、带领他们作战，这样大事就可以定下来了。如今却轻率地割让土地资助他们，使这三个人聚集在一起，又都处在边境战场上，只怕蛟龙一旦得到云雨，终究不会再是池中的东西了。”孙权考虑到曹操正在北方，应当广泛招揽英雄，又担心一时难以控制刘备，所以没有采纳这个建议。"
        }
      ],
      "source_anchor_ids": [
        "anc_04fc8b605beaa949",
        "anc_05876143f4f2b11f",
