      "phase_id": "hphase_1ece137dae255a95f6444e61",
      "segments": [
        {
          "conclusion_ids": [
            "hcon_9a9e7090aaa4ad3ea8925620"
          ],
          "event_id": null,
          "event_relation": null,
          "source_conclusion_ids": [
            "r3-c002-part-2"
          ],
          "text": "当初周瑜与孙策结为朋友，太妃又让孙权像对待兄长一样侍奉他。当时孙权的身份是将军，各位将领和宾客之间的礼节还比较简略，唯独周瑜首先对他极尽敬意，始终恪守臣子的礼节。他性情宽宏豁达，大体上很能赢得人心，只是与程普关系不和。"
        }
      ],
      "source": {
        "fragment_version": "r3-real-publication-01a0aa45-b717-7b29-bbae-afd7b72f7fcf-part-2",
        "paragraph_id": "r3-p002-part-2"
      },
