    {
      "conclusion_ids": [
        "hcon_fe8d013e2292abd36526f254"
      ],
      "content_ref": {
        "fragment_version": "r3-real-publication-01a0aa45-b717-7b29-bbae-afd7b72f7fcf-part-1",
        "paragraph_id": "r3-p005-part-1"
      },
      "entities": [],
